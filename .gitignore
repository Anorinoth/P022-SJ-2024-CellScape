# Data, outputs, reports — stored on separate drives, not in code repo
data/
outputs/
reports/
docs/
paper/

# renv library and cache — rebuild with renv::restore()
renv/library/
renv/staging/
renv/python/
renv/cache/

# R workspace / history binaries
*.RData
.RData
.Rhistory
*.Rhistory

# R session data
.Rapp.history

# Large data/analysis file types
*.rds
*.h5ad
*.qs
*.ome.tif
*.ome.tiff
*.tif
*.tiff

# Vendored binaries (bftools, bioio_env) — gitignored, reinstall from source
_vendored/

# Cruft files
cruft/

# Python
__pycache__/
*.pyc
*.pyo
.Python
bioio_env/

# graphify output (regenerated by graphify-rebuild.py)
graphify-out/

# IDE and AI tooling
.DS_Store
*.swp
*.swo
.claude/
.cursorrules

# Environment config (copy .Renviron.example to .Renviron and customize)
.Renviron

# Backup files
*.bak
*.surgery_backup
